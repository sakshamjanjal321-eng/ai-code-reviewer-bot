# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Configuration (Optional: fallback token if GITHUB_TOKEN is not passed by workflow)
# Needs repo scope to comment on Pull Requests
GITHUB_PAT=your_github_personal_access_token_here

# Webhook Configuration
# Webhook signature secrets to verify GitHub payloads
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here


# Server Configuration
HOST=0.0.0.0
PORT=8000
APP_ENV=development
DEBUG=False
RATE_LIMIT_PER_MINUTE=20

